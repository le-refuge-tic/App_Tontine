# URL de base de l'API backend (préfixe global /api/v1 inclus).
# - Téléphone réel sur le même Wi-Fi que le PC : http://192.168.1.20:3000/api/v1
# - Émulateur Android : http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1

# Mode démo : true pour afficher des données fictives (cas de Koffi) sans backend.
# Par défaut : false (l'app appelle le vrai backend NestJS).
EXPO_PUBLIC_MODE_DEMO=false
