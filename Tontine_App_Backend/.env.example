# ===== Environnement d'exécution =====
NODE_ENV=development
PORT=3000

# ===== Base de données PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tontine_dev

# ===== FedaPay (non utilisé à cette étape) =====
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# ===== URL publique de l'application (pour le callback FedaPay) =====
# Exemple ngrok : https://xxxx.ngrok.io
# Laisser vide en développement local sans tunnel
APP_PUBLIC_URL=
APP_ENV=development

# ===== CORS =====
CORS_ORIGIN=*

# ===== JWT =====
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_MOI_minimum_32_caracteres_alphanumeriques
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
JWT_RETRAIT_EXPIRES_IN=5m

# ===== Bcrypt =====
BCRYPT_ROUNDS=12

# ===== Throttling (ms, requêtes) =====
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ===== Premier administrateur (seed uniquement) =====
# Numéro au format international sans + ni espaces : 229 + 10 chiffres locaux
# Exemple : 2290197000000 pour le numéro local 0197000000
ADMIN_PHONE=
ADMIN_PASSWORD=
